# Makale figürleri: küçük (~1 MB) ve yayın teslim edilebiliri → TAKİP EDİLİR
!artifacts/figures/
!artifacts/figures/*.png

# V6 raporları (hafif JSON, ~40 KB) → TAKİP EDİLİR; checkpoint'ler (~11 MB) edilmez
!artifacts/v6_two_stage/
artifacts/v6_two_stage/checkpoints/
# Türetilmiş önbellek (yeniden üretilebilir: --recompute) → takip edilmez
artifacts/v6_two_stage/*.npz
# V6.7 gönderim modelleri (~105 MB + joblib) ve gömülü xrv ağırlıkları (~350 MB)
artifacts/v6_two_stage/submission_fulldata/
submission_docker/weights/
# Deney/geçici çıktılar ve konteyner duman testi artefaktları
scratch/

# xrv agirlik onbellegi (workspace ici; ~150 MB)
